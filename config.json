{
  "apiUrl": "http://localhost:3000",

  "ranges": {
    "ambient": {
      "min": 0,
      "max": 2
    },
    "hemisphere": {
      "min": 0,
      "max": 2
    },
    "directional": {
      "min": 0,
      "max": 2
    },
    "lightX": {
      "min": -1,
      "max": 1
    },
    "lightY": {
      "min": -1,
      "max": 1
    },
    "lightZ": {
      "min": -1,
      "max": 1
    },
    "pitch": {
      "min": -180,
      "max": 180
    },
    "yaw": {
      "min": -180,
      "max": 180
    },
    "roll": {
      "min": -180,
      "max": 180
    },
    "zoom": {
      "min": 0.25,
      "max": 5
    },
    "layerScale": {
      "min": 1,
      "max": 1.25
    }
  },

  "defaults": {
    "lighting": {
      "ambient": 0.4,
      "hemisphere": 0.6,
      "directional": 1,
      "lightX": 1,
      "lightY": 1,
      "lightZ": 1
    },

    "head": {
      "pitch": 0,
      "yaw": 0,
      "roll": 0
    },

    "camera": {
      "zoom": {
        "head": 1,
        "body": 0.7
      }
    },

    "layer": {
      "enabled": true,
      "scale": 1.08
    }
  }
}