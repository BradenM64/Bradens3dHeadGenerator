{
  "apiUrl": "http://localhost:3000",

  "defaults": {
    "camera": {
      "zoom": {
        "head": 1.7,
        "body": 1.07
      }
    },
    "head": {
      "pitch": 10,
      "yaw": 25,
      "roll": 0
    },
    "lighting": {
      "ambient": 1.0,
      "hemisphere": 0,
      "directional": 0,
      "lightX": -1.0,
      "lightY": 0,
      "lightZ": 1.0
    },
    "layer": {
      "enabled": true,
      "scale": 1.04
    }
  },

  "ranges": {
    "ambient": {
      "min": 0,
      "max": 2
    },
    "hemisphere": {
      "min": 0,
      "max": 2
    },
    "directional": {
      "min": 0,
      "max": 2
    },
    "lightX": {
      "min": -2,
      "max": 2
    },
    "lightY": {
      "min": -2,
      "max": 2
    },
    "lightZ": {
      "min": -2,
      "max": 2
    },
    "pitch": {
      "min": -180,
      "max": 180
    },
    "yaw": {
      "min": -180,
      "max": 180
    },
    "roll": {
      "min": -180,
      "max": 180
    },
    "zoom": {
      "min": 0.5,
      "max": 3
    },
    "layerScale": {
      "min": 1,
      "max": 1.5
    }
  }
}